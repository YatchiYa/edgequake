# =============================================================================
# EdgeQuake v0.26.1 — configuration d'environnement
# Compatible Langfuse 3.22 -> 3.155.1 OSS -> v4 (transport auto-detecte)
# =============================================================================
# Aucune valeur secrete dans ce fichier. Les 4 lignes marquees [SECRET] sont a
# injecter depuis votre coffre (Vault / Secret Kubernetes), pas a versionner.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Base de donnees  (OBLIGATOIRE)
# -----------------------------------------------------------------------------
# PostgreSQL 16, 17 ou 18 + extensions pgvector et Apache AGE.
# Le parametre search_path=public est requis (AGE le modifie sinon).
# [SECRET]
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/edgequake?options=-c%20search_path%3Dpublic


# -----------------------------------------------------------------------------
# 2. Fournisseur LLM  (OBLIGATOIRE)
# -----------------------------------------------------------------------------
# Trois roles distincts : generation, embeddings, vision (PDF -> markdown).
EDGEQUAKE_DEFAULT_LLM_PROVIDER=mistral
EDGEQUAKE_DEFAULT_LLM_MODEL=mistral-small-latest
EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=mistral
EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=mistral-embed
EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=1024
EDGEQUAKE_VISION_PROVIDER=mistral
EDGEQUAKE_VISION_MODEL=pixtral-12b-2409

# [SECRET] la cle du fournisseur retenu
MISTRAL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ATTENTION : la dimension d'embedding est figee par workspace. Changer de
# modele d'embedding sur un workspace deja peuple impose un
# POST /api/v1/workspaces/{id}/rebuild-embeddings.


# -----------------------------------------------------------------------------
# 3. Observabilite Langfuse  (OPTIONNEL)
# -----------------------------------------------------------------------------
# URL SANS chemin ni "/" final : EdgeQuake ajoute lui-meme le chemin d'API.
# En Kubernetes, viser le Service Langfuse, jamais localhost.
LANGFUSE_BASE_URL=https://langfuse.votre-domaine-interne
LANGFUSE_PROJECT_ID=
EDGEQUAKE_LANGFUSE_ENABLED=1

# Transport : LAISSER "auto".
# EdgeQuake sonde /api/public/otel/v1/traces au demarrage :
#   endpoint present (>= 3.22, dont 3.155.1 et v4)  -> OTLP/HTTP
#   endpoint absent  (< 3.22)                       -> API native /api/public/ingestion
# Ne forcer "otlp" ou "ingestion" que sur demande du support.
EDGEQUAKE_LANGFUSE_API=auto

# [SECRET] cles du projet Langfuse (valides uniquement sur l'instance emettrice)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Ne PAS definir LANGFUSE_HOST en plus de LANGFUSE_BASE_URL : LANGFUSE_HOST
# n'est qu'un repli. Une valeur VIDE equivaut a "non definie" et declenche un
# repli silencieux vers https://cloud.langfuse.com — les traces sortiraient
# alors du reseau interne.


# -----------------------------------------------------------------------------
# 4. Serveur et journalisation
# -----------------------------------------------------------------------------
EDGEQUAKE_HOST=0.0.0.0
EDGEQUAKE_PORT=8080
RUST_LOG=info
# Diagnostic Langfuse temporaire :
# RUST_LOG=info,opentelemetry_sdk=debug,opentelemetry_otlp=debug


# -----------------------------------------------------------------------------
# 5. Securite  (OBLIGATOIRE EN PRODUCTION)
# -----------------------------------------------------------------------------
EDGEQUAKE_DEV_MODE=false
EDGEQUAKE_AUTH_ENABLED=true
EDGEQUAKE_STRICT_STARTUP=1
EDGEQUAKE_CORS_ORIGINS=https://edgequake.votre-domaine-interne
JWT_EXPIRY_HOURS=1

# [SECRET] >= 32 octets aleatoires, sinon refus de demarrage
JWT_SECRET=
# Amorcage du premier administrateur (lu au tout premier demarrage seulement)
# EDGEQUAKE_BOOTSTRAP_ADMIN_USERNAME=admin
# EDGEQUAKE_BOOTSTRAP_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 6. Capacite  (facultatif, valeurs par defaut raisonnables)
# -----------------------------------------------------------------------------
WORKER_THREADS=4
# EDGEQUAKE_TASK_MAX_WORKERS=4
# EDGEQUAKE_MAX_CONCURRENT_EXTRACTIONS=16
# EDGEQUAKE_CHUNK_TIMEOUT_SECS=180        # 600 si LLM auto-heberge


# -----------------------------------------------------------------------------
# 7. Catalogue de modeles  (facultatif)
# -----------------------------------------------------------------------------
# models.toml est EMBARQUE dans le binaire a la compilation. Ne definir cette
# variable que pour surcharger le catalogue ; le chemin doit exister DANS le
# conteneur (ConfigMap monte).
# EDGEQUAKE_MODELS_CONFIG=/app/models.toml
