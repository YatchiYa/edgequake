    <node id="Question Generation">
      <data key="d0">Question Generation</data>
      <data key="d1">method</data>
      <data key="d2">A process where an LLM generates five RAG users with detailed descriptions and five tasks per user, each accompanied by five questions requiring understanding of the entire corpus, resulting in 125 questions per dataset.</data>
      <data key="d3">doc-68c5b57fc5e4f80b4481763ee3f107c6-chunk-004</data>
      <data key="d4">unknown_source</data>
