    <node id="Chunking">
      <data key="d0">Chunking</data>
      <data key="d1">method</data>
      <data key="d2">Chunking is a process of breaking down large text corpora into smaller segments to enhance the accuracy of information retrieval in RAG systems.</data>
      <data key="d3">doc-68c5b57fc5e4f80b4481763ee3f107c6-chunk-000</data>
      <data key="d4">unknown_source</data>
