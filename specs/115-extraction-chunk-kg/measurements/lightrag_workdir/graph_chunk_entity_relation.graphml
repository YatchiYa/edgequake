    <node id="Corporate Mergers">
      <data key="d0">Corporate Mergers</data>
      <data key="d1">event</data>
      <data key="d2">Corporate mergers are business activities influenced by Indigenous perspectives, focusing on sustainable and equitable outcomes through community engagement and respect for traditional land use.</data>
