    <node id="Public Transportation Infrastructure">
      <data key="d0">Public Transportation Infrastructure</data>
      <data key="d1">concept</data>
      <data key="d2">Public Transportation Infrastructure refers to the systems and facilities supporting public transportation, including roads, railways, and transit networks.</data>
