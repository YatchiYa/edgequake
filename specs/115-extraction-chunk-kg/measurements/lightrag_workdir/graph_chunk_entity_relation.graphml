    <node id="Vector Representation">
      <data key="d0">Vector Representation</data>
      <data key="d1">method</data>
      <data key="d2">Vector Representation is a numerical encoding of data (e.g., text) into vectors, enabling efficient similarity searches and retrieval in RAG systems.</data>
      <data key="d3">doc-68c5b57fc5e4f80b4481763ee3f107c6-chunk-000</data>
