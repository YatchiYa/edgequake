    <node id="Naive RAG">
      <data key="d0">Naive RAG</data>
      <data key="d1">method</data>
      <data key="d2">A standard baseline RAG system that segments raw texts into chunks, stores them in a vector database using text embeddings, and retrieves text chunks based on highest similarity for efficient matching.</data>
      <data key="d3">doc-68c5b57fc5e4f80b4481763ee3f107c6-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1786372041</data>
