    </node>
    <node id="HyDE">
      <data key="d0">HyDE</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval-augmented generation system that serves as a baseline for comparison, focusing on query generation.&lt;SEP&gt;A method utilizing an LLM to generate a hypothetical document based on the input query, which is then used to retrieve relevant text chunks for formulating the final answer.</data>
      <data key="d3">doc-68c5b57fc5e4f80b4481763ee3f107c6-chunk-004&lt;SEP&gt;doc-68c5b57fc5e4f80b4481763ee3f107c6-chunk-005</data>
