# Optional overrides for docker-compose.langfuse.yml.
# Copy to langfuse.env (gitignored via *.env) only if you need to change ports/secrets.
# `make langfuse-up` works with Compose defaults — this file is not required.
#
# Do not point DATABASE_URL at EdgeQuake Postgres. Langfuse has its own DB.

LANGFUSE_PORT=3310
NEXTAUTH_URL=http://localhost:3310

# Must match repo-root .env local Langfuse block and Compose LANGFUSE_INIT_*:
# LANGFUSE_PUBLIC_KEY=pk-lf-edgequake-local
# LANGFUSE_SECRET_KEY=sk-lf-edgequake-local-dev
# LANGFUSE_BASE_URL=http://localhost:3310
# LANGFUSE_PROJECT_ID=edgequake-local
