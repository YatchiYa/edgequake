---

<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="font-display text-3xl font-bold tracking-tight mkt-text sm:text-4xl">
        Built for real Graph-RAG work
      </h2>
      <p class="mt-4 text-lg mkt-text-muted">
        Ingest once, keep structure and lineage, then answer with the retrieval
        mode that fits the question — on a stack you can run and upgrade.
      </p>
    </div>

    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <a
            href={f.href}
            class="group block border-b border-transparent pb-6 transition-colors hover:border-accent-500/40"
          >
            <div class="mkt-accent-surface mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg">
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={iconPaths[f.icon]} />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mkt-text group-hover:mkt-accent-text transition-colors">
              {f.title}
            </h3>
            <p class="mt-2 text-sm mkt-text-muted leading-relaxed">
              {f.description}
            </p>
          </a>
        ))
      }
    </div>

    <p class="mt-12 text-center text-sm mkt-text-dim">
      Also: explicit
      <code class="mkt-text-secondary">edgequake migrate</code> upgrades, hybrid
      cloud LLM + local embeddings, and side-by-side PDF citations.
      <a href="/docs/whats-new/" class="mkt-accent-text hover:underline ml-1"
        >See what’s new →</a
      >
    </p>
  </div>
</section>
