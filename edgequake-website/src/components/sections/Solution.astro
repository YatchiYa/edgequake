---
/**
 * Solution — current product capabilities in plain English.
 */
const features = [
  {
    icon: "brain",
    title: "Knowledge graph on Postgres",
    description:
      "Entities and relationships live in ordinary PostgreSQL tables with pgvector. Apache AGE is optional — product images work without it.",
    href: "/docs/architecture/",
  },
  {
    icon: "users",
    title: "Members, invites, and magic links",
    description:
      "Invite teammates, set roles, suspend accounts, and issue one-time sign-in or password-reset links — without wiring SMTP first.",
    href: "/tutorial/14-members-and-invites/",
  },
  {
    icon: "shield",
    title: "SSO and workspace isolation",
    description:
      "OIDC / Keycloak sign-in and Postgres row-level security keep tenants and workspaces separated across UI, API, and MCP.",
    href: "/docs/security/",
  },
  {
    icon: "bot",
    title: "MCP for AI agents",
    description:
      "Assistants can search, ingest, upload, delete, poll jobs, download documents, and fetch graph images through MCP.",
    href: "/docs/integrations/",
  },
  {
    icon: "file-text",
    title: "PDF vision and manuscripts",
    description:
      "Turn hard PDFs into usable markdown — tables, layouts, and scanned or handwritten pages with a dedicated manuscript path.",
    href: "/docs/tutorials/pdf-ingestion/",
  },
  {
    icon: "plug",
    title: "Any LLM, encrypted connections",
    description:
      "OpenAI, Anthropic, Mistral, Gemini, or Ollama / LM Studio. Save connections with encrypted keys; the wizard finds local servers.",
    href: "/docs/providers/",
  },
];

const iconPaths: Record<string, string> = {
  brain:
    "M12 2a7 7 0 017 7c0 2-1 3.5-2.5 4.5M12 2a7 7 0 00-7 7c0 2 1 3.5 2.5 4.5M12 2v4M8.5 8.5L12 12l3.5-3.5M12 22v-8M7 14.5C5 15.5 4 17 4 19a3 3 0 003 3h10a3 3 0 003-3c0-2-1-3.5-3-4.5",
  users:
    "M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75",
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
  bot: "M12 8V4H8M2 14h2M20 14h2M15 13a3 3 0 11-6 0v3h6v-3zM12 20v2M9 13h.01M15 13h.01M6 10a6 6 0 1112 0v4a6 6 0 01-12 0v-4z",
  "file-text":
    "M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8",
  plug: "M12 22v-5M9 8V2M15 8V2M6 8h12v5a6 6 0 01-12 0V8z",
