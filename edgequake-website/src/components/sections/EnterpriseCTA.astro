---
/**
 * EnterpriseCTA — conversion close. frontend-design skill: no eyebrow, no arrow
 * glyph, no "WORD — fragment" trust strings, restrained motion, left-aligned.
 */
import Button from "../primitives/Button.astro";
import Icon from "../primitives/Icon.astro";
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";
import type { IconName } from "../data/icons";

const pillars: { icon: IconName; title: string; description: string }[] = [
  {
    icon: "shield",
    title: "SSO, members, and audit",
    description:
      "OIDC and Keycloak, invitations, role guards, and audit trails for teams that need real access boundaries.",
  },
  {
    icon: "headphones",
    title: "Priority support",
    description:
      "Architecture reviews, rollout plans, troubleshooting, and production issues with the team that builds EdgeQuake.",
  },
  {
    icon: "settings",
    title: "Your models, your network",
    description:
      "Private LLMs, encrypted connections, on-prem Docker or Kubernetes, and explicit migrations — no forced cloud path.",
  },
];

const trust = [
  "Apache-2.0 licensed, so there is no lock-in",
  "Runs on-premise, so your data stays on your network",
  "Works without any cloud embedding dependency",
];
---

<Section tone="alt">
  <SectionHeader
    title="Taking Graph-RAG into production?"
    lede="Internal platforms, customer copilots, and regulated installs that need more than a demo stack."
  />

  <div class="mt-12 grid gap-10 sm:grid-cols-3">
    {
      pillars.map((p) => (
        <div>
          <span class="mkt-accent-surface inline-flex h-11 w-11 items-center justify-center rounded-lg">
            <Icon name={p.icon} class="h-[22px] w-[22px]" />
          </span>
          <h3 class="mt-4 text-base font-semibold mkt-text">{p.title}</h3>
          <p class="mt-2 text-sm mkt-text-muted leading-relaxed">{p.description}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-12 flex flex-col items-start gap-6">
    <Button href="/contact/" variant="primary" size="lg">Talk to the team</Button>

    <ul class="flex flex-col gap-2 text-sm mkt-text-muted">
      {
        trust.map((t) => (
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-4 w-4 mkt-success-text" />
            {t}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
