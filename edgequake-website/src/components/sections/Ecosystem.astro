---
/**
 * Ecosystem — product surfaces + crate map (SPEC-170: composes primitives).
 */
import { getProductVersion } from "../../lib/product";
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";

const version = getProductVersion();

const surfaces = [
  {
    name: "Web UI",
    description:
      "Documents, query, knowledge graph, members, connections, and settings in one app.",
  },
  {
    name: "REST + OpenAPI",
    description:
      "Ingest, query, stream, and manage workspaces. Swagger at /swagger-ui.",
  },
  {
    name: "MCP",
    description:
      "Search, ingest, upload, delete, poll tasks, download docs, and graph images for agents.",
  },
  {
    name: "GHCR images",
    description:
      "api, frontend, postgres (pg16/17/18), and keycloak — multi-arch amd64 + arm64.",
  },
];

const crates = [
  { name: "edgequake-core", description: "Pipeline orchestration, workspaces, and top-level APIs." },
  { name: "edgequake-api", description: "HTTP service: ingest, query, health, streaming, auth." },
  { name: "edgequake-storage", description: "KV, vector, and graph storage on PostgreSQL + pgvector." },
  { name: "edgequake-pipeline", description: "Chunking, extraction, relationships, and graph build." },
  { name: "edgequake-query", description: "naive, local, global, hybrid, mix, and bypass retrieval." },
  { name: "edgequake-llm", description: "Provider adapters: OpenAI, Ollama, Anthropic, mocks, and more." },
  { name: "edgequake-pdf", description: "PDF to markdown, vision layouts, manuscript pages." },
  { name: "edgequake-auth", description: "Sessions, SSO (OIDC), members, invitations, magic links." },
];
---

<Section>
  <SectionHeader
    title="One product, clear surfaces"
    lede={`Run the full stack from Docker, or embed the Rust crates. Everything below ships as v${version}.`}
  />

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      surfaces.map((s) => (
        <div>
          <h3 class="text-base font-semibold mkt-text">{s.name}</h3>
          <p class="mt-2 text-sm mkt-text-muted leading-relaxed">
            {s.description}
          </p>
        </div>
      ))
    }
  </div>

  <h3 class="mt-16 text-base font-semibold mkt-text">Rust workspace crates</h3>
  <div class="mt-5 grid gap-px overflow-hidden rounded-xl border mkt-border sm:grid-cols-2">
    {
      crates.map((c) => (
        <div class="mkt-bg-card-solid p-4">
          <h4 class="text-sm font-semibold font-mono mkt-accent-text">
            {c.name}
          </h4>
          <p class="mt-1.5 text-xs mkt-text-muted leading-relaxed">
            {c.description}
          </p>
        </div>
      ))
    }
  </div>
</Section>
