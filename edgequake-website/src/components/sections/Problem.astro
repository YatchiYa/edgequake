---
/**
 * Problem — why traditional RAG fails. frontend-design skill: not a kit of
 * identical cards; a divided reasoned list. No per-item reveal/hover chrome.
 */
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";

const problems = [
  {
    title: "Relationships get lost",
    description:
      "Ask how service A depends on team B's contracts and vector search returns unrelated paragraphs. It holds text proximity, not edges, ownership, or causality between entities.",
  },
  {
    title: "It slows down at scale",
    description:
      "A 10,000-document import that was fine at 100 docs takes hours in Python. Extraction, embedding, and re-ingestion compound as the corpus grows — before a single query runs.",
  },
  {
    title: "One retrieval mode fits nothing",
    description:
      "Some questions need a precise paragraph, others a cross-document overview. Forcing every query through the same path guarantees a wrong answer for one of them.",
  },
  {
    title: "Tenancy is an afterthought",
    description:
      "Sharing one index across projects quietly bleeds context between workspaces. Adding isolation later means rebuilding the index from scratch.",
  },
  {
    title: "PDFs break the pipeline",
    description:
      "Multi-column layouts, embedded figures, and scanned pages defeat naive extraction. The answer you need ends up locked in a table that became garbage text on import.",
  },
  {
    title: "Cloud-only costs add up",
    description:
      "Every retrieval that needs a remote embedding API compounds cost at scale — and when the provider rate-limits or goes down, your search degrades with it.",
  },
];
---

<Section tone="alt">
  <SectionHeader
    title="Similarity search loses the thread"
    lede="Vector search finds nearby text. It struggles when the answer lives in relationships, spans documents, or hides inside a messy PDF, and when production needs clear workspace boundaries."
  />

  <div class="mt-12 grid gap-x-12 gap-y-0 sm:grid-cols-2">
    {
      problems.map((p) => (
        <div class="border-t mkt-border-subtle py-6">
          <h3 class="text-base font-semibold mkt-text">{p.title}</h3>
          <p class="mt-2 text-sm mkt-text-muted leading-relaxed">
            {p.description}
          </p>
        </div>
      ))
    }
  </div>
</Section>
