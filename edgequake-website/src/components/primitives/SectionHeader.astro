---
/**
 * SectionHeader — the one band-header renderer (SPEC-170 REQ-170-10).
 * frontend-design skill: no ALL-CAPS tracked eyebrow, no single-word color
 * accent. Left-aligned by default (engineered feel); type does the work.
 */
interface Props {
  title: string;
  lede?: string;
  align?: "left" | "center";
  class?: string;
}

const { title, lede, align = "left", class: className = "" } = Astro.props;
const isCenter = align === "center";
---

<div
  class:list={[
    isCenter ? "text-center mx-auto max-w-2xl" : "max-w-3xl",
    className,
  ]}
>
  <h2
    class="font-display font-semibold tracking-[-0.02em] mkt-text text-[clamp(1.7rem,1.35rem+1.4vw,2.2rem)] leading-[1.1]"
  >
    <Fragment set:html={title} />
  </h2>
  {
    lede && (
      <p
        class:list={[
          "mt-4 text-lg leading-relaxed mkt-text-muted max-w-2xl",
          isCenter && "mx-auto",
        ]}
      >
        <Fragment set:html={lede} />
      </p>
    )
  }
</div>
