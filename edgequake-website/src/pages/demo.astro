---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { Code } from "@astrojs/starlight/components";
import { DEMO_URL, getProductVersion } from "../lib/product";

const version = getProductVersion();
const quickstart = `curl -fsSL https://raw.githubusercontent.com/raphaelmansuy/edgequake/edgequake-main/quickstart.sh | sh

# Pin this release:
# EDGEQUAKE_VERSION=${version} sh quickstart.sh

# Web UI → http://localhost:3000`;
---

<MarketingLayout
  title="Try EdgeQuake — Demo and local run"
  description="Open the public demo, follow the picture tour, or start the full stack locally with one Docker command."
>
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-bold tracking-tight mkt-text sm:text-5xl">
        Try EdgeQuake
      </h1>
      <p class="mt-6 text-lg mkt-text-muted leading-relaxed">
        Three short paths: a live demo, a screenshot tour, or your own machine
        with Docker.
      </p>

      <ol class="mt-12 space-y-10">
        <li>
          <h2 class="text-xl font-semibold mkt-text">1. Live demo</h2>
          <p class="mt-2 text-sm mkt-text-muted leading-relaxed">
            A hosted stack at demo.edgequake.com. Sign in with the credentials
            you were given, then upload, query, and open the graph.
          </p>
          <a
            href={DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center rounded-lg bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-500 transition-colors"
          >
            Open demo.edgequake.com
          </a>
        </li>

        <li>
          <h2 class="text-xl font-semibold mkt-text">2. Picture tour</h2>
          <p class="mt-2 text-sm mkt-text-muted leading-relaxed">
            Fourteen chapters with screenshots: sign-in, documents, six query
            modes, the map, connections, and members &amp; invites (v{version}).
          </p>
          <a
            href="/tutorial/"
            class="mt-4 inline-flex mkt-outline-button px-5 py-2.5 text-sm font-semibold"
          >
            Start the tour
          </a>
        </li>

        <li>
          <h2 class="text-xl font-semibold mkt-text">3. Run locally</h2>
          <p class="mt-2 text-sm mkt-text-muted leading-relaxed">
            Needs Docker only. The wizard detects Ollama, LM Studio, or a cloud
            key. Ports bind to localhost.
          </p>
          <div class="mt-4 mkt-code-showcase rounded-xl border p-4 overflow-x-auto">
            <Code code={quickstart} lang="bash" title="Terminal" />
          </div>
          <p class="mt-3 text-sm mkt-text-dim">
            Full install notes:
            <a
              href="/docs/getting-started/installation/"
              class="mkt-accent-text hover:underline">installation guide</a
            >.
          </p>
        </li>
      </ol>

      <div class="mt-14 border-t mkt-border pt-8">
        <h2 class="text-lg font-semibold mkt-text">What to check</h2>
        <ul class="mt-3 space-y-2 text-sm mkt-text-muted list-disc pl-5">
          <li>Document upload and processing status</li>
          <li>Entity extraction and the knowledge graph</li>
          <li>The same question in hybrid vs local vs global</li>
          <li>Citations that open the source PDF page</li>
          <li>Members invite flow (if you have admin access)</li>
        </ul>
      </div>
    </div>
  </section>
</MarketingLayout>
