---
import EcosystemSection from "../components/sections/Ecosystem.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { getProductVersion } from "../lib/product";

const version = getProductVersion();
---

<MarketingLayout
  title="Ecosystem — UI, API, MCP, and crates"
  description="EdgeQuake product surfaces: Web UI, REST/OpenAPI, MCP for agents, GHCR images, and the modular Rust workspace."
>
  <section class="pt-24 pb-8 sm:pt-32">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl font-bold tracking-tight mkt-text sm:text-5xl">
        The EdgeQuake ecosystem
      </h1>
      <p class="mt-6 text-lg mkt-text-muted">
        Ship the product as Docker images, talk to it over REST or MCP, or embed
        the Rust crates. Current line: <strong class="mkt-text-secondary"
          >v{version}</strong
        >.
      </p>
    </div>
  </section>

  <EcosystemSection />

  <section class="pb-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-8">
      <div>
        <h2 class="text-xl font-semibold mkt-text">Fastest install</h2>
        <p class="mt-2 text-sm mkt-text-muted">
          Prefer Docker over crates.io for the full stack (UI + API + Postgres):
        </p>
        <pre
          class="mt-3 mkt-code-surface rounded-lg p-4 text-sm overflow-x-auto mkt-accent-text"
        ><code>curl -fsSL https://raw.githubusercontent.com/raphaelmansuy/edgequake/edgequake-main/quickstart.sh | sh</code></pre>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/demo/" class="mkt-accent-text hover:underline">Try the demo</a>
        <a href="/docs/getting-started/" class="mkt-accent-text hover:underline"
          >Getting started</a
        >
        <a href="/docs/integrations/" class="mkt-accent-text hover:underline"
          >MCP and integrations</a
        >
        <a href="/enterprise/" class="mkt-accent-text hover:underline"
          >Enterprise</a
        >
      </div>
    </div>
  </section>
</MarketingLayout>
