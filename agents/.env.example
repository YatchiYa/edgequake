# Written by `uv run python scripts/bootstrap_key.py` (agents/.env, chmod 600).
EDGEQUAKE_URL=http://localhost:8090
EDGEQUAKE_API_KEY=eq_xxxxxxxx          # read+query scoped key ("adk-agents")
EDGEQUAKE_TENANT_ID=f62e6a67-9a75-4654-b2b6-1a6168bda5ba
EDGEQUAKE_WORKSPACE_ID=55a78878-845c-4abe-a8ba-8ceb9d067b90

# Model: any LiteLLM id, or a bare Gemini id for ADK's native client.
EQ_AGENT_MODEL=mistral/mistral-medium-latest
MISTRAL_API_KEY=
# Per-agent override: EQ_MODEL_<AGENT_NAME>, e.g.
# EQ_MODEL_INVESTIGATOR_AGENT=mistral/mistral-large-latest

# Gemini on Vertex AI (ADC: `gcloud auth application-default login`)
# EQ_AGENT_MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=europe-west1

# Custom UI server (server.py)
# EQ_UI_HOST=127.0.0.1
# EQ_UI_PORT=8765
# EQ_MAX_LLM_CALLS=25          # per run
# EQ_SESSION_LLM_BUDGET=150     # per session (guardrails.count_llm_call)
# EQ_LOG_LEVEL=INFO

# /v1 product API (web UI, SPEC-165)
# AGENTS_INTERNAL_TOKEN=        # shared secret with the Next.js proxy; unset = /v1 disabled (503)
# EQ_DATA_DIR=./.data           # agents.db, sessions.db, artifacts/  (/data in the image)
# EQ_ALLOWED_MODELS=mistral/mistral-medium-latest,mistral/mistral-small-latest,mistral/mistral-large-latest
